# Copy this file to .env and fill it in. .env is ignored by git.

# --- Sign in with Google ---
# Leave GOOGLE_CLIENT_ID empty to keep the app open (no login).
# Create it in Google Cloud Console: APIs & Services > Credentials >
# OAuth client ID > Web application, with http://localhost:1337 (and your
# deployed URL) as Authorized JavaScript origins. Use a Client ID made for
# this app, not one from another project.
GOOGLE_CLIENT_ID=
# A long random string. Without it everyone is signed out on every restart.
SESSION_SECRET=

# --- AI helpers (turned off for now; see issue #9 before enabling) ---
# AI_ENABLED=true
# GEMINI_API_KEY=
