# Copy this file to .env and fill it in. .env is ignored by git.

# --- Sign in with Google (through Firebase Authentication) ---
# Leave these empty to keep the app open (no login). All three are needed.
# Firebase console > Authentication > Sign-in method > enable Google, then
# Project settings > Your apps > Web app, and copy projectId and apiKey.
# Also add your deployed domain under Authentication > Settings > Authorized domains.
# These web-config values are not secrets.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Only if you don't use <projectId>.firebaseapp.com:
# FIREBASE_AUTH_DOMAIN=
# A long random string. Without it everyone is signed out on every restart.
SESSION_SECRET=

# --- Syncing your data across devices (needs sign-in above) ---
# On Vercel: Storage > Create > Upstash for Redis, then connect it to this project;
# it adds these two for you. Leave them empty locally: the app then keeps a copy
# in data/store.json instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: where the local copy goes (default data/store.json).
# DATA_FILE=
# Encrypts everyone's synced data before it is stored. At least 32 characters;
# make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it: without it the synced copy can't be read.
DATA_ENCRYPTION_KEY=

# --- AI helpers (turned off for now; see issue #9 before enabling) ---
# AI_ENABLED=true
# GEMINI_API_KEY=
